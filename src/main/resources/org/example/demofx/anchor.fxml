<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="320.0" prefWidth="480.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demofx.AnchorPaneController">
   <children>
      <Label layoutX="24.0" layoutY="20.0" text="Clinica Dental - Ejemplo AnchorPane" />
      <Label layoutX="24.0" layoutY="60.0" text="Nombre:" />
      <TextField fx:id="campoNombre" layoutX="100.0" layoutY="56.0" promptText="Escribe tu nombre" />
      <Button fx:id="botonSaludar" layoutX="24.0" layoutY="104.0" mnemonicParsing="false" onAction="#onSaludarClick" text="Saludar" />
      <Label fx:id="mensaje" layoutX="24.0" layoutY="148.0" text="Pulsa Saludar." />
      <Button layoutX="24.0" layoutY="188.0" mnemonicParsing="false" onAction="#onVolverClick" text="Volver a VBox" />
   </children>
</AnchorPane>
