<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="640.0" prefWidth="1100.0" style="-fx-background-color: #F1F5F9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demofx.PrimaryController">
   <stylesheets>
      <URL value="@agenda.css" />
   </stylesheets>
   <children>
      <!-- Barra superior -->
      <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="topbar">
         <padding>
            <Insets bottom="8.0" left="12.0" right="12.0" top="8.0" />
         </padding>
         <children>
            <Label style="-fx-font-size: 14px;" text="🦷" />
            <Label maxWidth="1.7976931348623157E308" styleClass="topbar-title" text="Dentrix Dental — Agenda y Programación de Turnos" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCambiarVista" mnemonicParsing="false" onAction="#onCambiarVista" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 10px; -fx-background-radius: 6;" text="Vista AnchorPane" />
            <Button mnemonicParsing="false" styleClass="topbar-btn" text="–" />
            <Button mnemonicParsing="false" styleClass="topbar-btn" text="▢" />
            <Button mnemonicParsing="false" styleClass="topbar-btn" text="✕" />
         </children>
      </HBox>
      <!-- Contenido: sidebar + panel central -->
      <HBox VBox.vgrow="ALWAYS">
         <children>
            <!-- Sidebar -->
            <VBox maxWidth="180.0" minWidth="180.0" prefWidth="180.0" spacing="6.0" styleClass="sidebar">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label style="-fx-font-size: 18px;" text="🦷" />
                        <VBox spacing="0.0">
                           <children>
                              <Label styleClass="logo-title" text="Dentrix" />
                              <Label styleClass="logo-sub" text="Centro Odontológico" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <VBox spacing="3.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-btn" text="🏠  Inicio" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-btn" text="🚨  Triaje / Asistencia" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-btn" text="👥  Pacientes" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-btn-active" text="📅  Agenda Citas" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-btn" text="📋  Ficha Clínica" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-btn" text="💳  Caja / Cobros" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-btn" text="📊  Reportes" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-btn" text="⚙  Configuración" />
                     </children>
                  </VBox>
                  <Region VBox.vgrow="ALWAYS" />
                  <VBox spacing="4.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                           <children>
                              <Label style="-fx-background-color: #E0F7F6; -fx-border-color: #00A896; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 4 6 4 6; -fx-text-fill: #0F766E; -fx-font-weight: bold; -fx-font-size: 10px;" text="RC" />
                              <VBox>
                                 <children>
                                    <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="Cristina Campos" />
                                    <Label styleClass="logo-sub" text="Agenda y Turnos" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onCerrarSesion" styleClass="btn-danger" text="🔒  Cerrar Sesión" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            <!-- Panel central -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
               </padding>
               <children>
                  <!-- Filtros -->
                  <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="panel">
                     <padding>
                        <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
                     </padding>
                     <children>
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="📅 Fecha:" />
                        <DatePicker fx:id="dpFiltroFecha" prefWidth="135.0" />
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="Consultorio / Doctor:" />
                        <ComboBox fx:id="cbFiltroConsultorio" prefWidth="280.0" promptText="Seleccione…" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnNuevaCita" mnemonicParsing="false" onAction="#onNuevaCitaClick" styleClass="btn-primary" text="➕  Nueva Cita" />
                     </children>
                  </HBox>
                  <!-- Formulario + grilla -->
                  <HBox spacing="10.0" VBox.vgrow="ALWAYS">
                     <children>
                        <VBox maxWidth="350.0" minWidth="350.0" prefWidth="350.0" spacing="8.0" styleClass="panel">
                           <padding>
                              <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                           </padding>
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label maxWidth="1.7976931348623157E308" styleClass="panel-title" text="FORMULARIO DE CITA" HBox.hgrow="ALWAYS" />
                                    <Label styleClass="code" text="MOD-CITA" />
                                 </children>
                              </HBox>
                              <Label styleClass="field-label" text="IDENTIFICACIÓN DEL PACIENTE (DNI) *" />
                              <HBox spacing="8.0">
                                 <children>
                                    <TextField fx:id="txtDni" promptText="8 dígitos" text="47895612" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnValidar" mnemonicParsing="false" onAction="#onValidarClick" text="Validar" />
                                 </children>
                              </HBox>
                              <Label fx:id="lblPaciente" style="-fx-font-size: 10px;" text="Paciente: Juan Pérez Alania" />
                              <Label styleClass="field-label" text="ODONTÓLOGO &amp; CONSULTORIO ASIGNADO *" />
                              <ComboBox fx:id="cbOdontologo" maxWidth="1.7976931348623157E308" promptText="Seleccione…" />
                              <Label styleClass="field-label" text="TRATAMIENTO / SERVICIO *" />
                              <ComboBox fx:id="cbTratamiento" maxWidth="1.7976931348623157E308" promptText="Seleccione…" />
                              <HBox spacing="8.0">
                                 <children>
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="field-label" text="FECHA DE CITA *" />
                                          <DatePicker fx:id="dpFecha" maxWidth="1.7976931348623157E308" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="field-label" text="HORARIO DISPONIBLE *" />
                                          <ComboBox fx:id="cbHorario" maxWidth="1.7976931348623157E308" promptText="Seleccione…" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <Region VBox.vgrow="ALWAYS" />
                              <Button fx:id="btnGuardar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onGuardarClick" styleClass="btn-primary" text="💾 Guardar Cita" />
                              <HBox spacing="8.0">
                                 <children>
                                    <Button fx:id="btnEliminar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onEliminarClick" styleClass="btn-danger" text="🗑 Eliminar" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="panel" HBox.hgrow="ALWAYS">
                           <padding>
                              <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                           </padding>
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label maxWidth="1.7976931348623157E308" styleClass="panel-title" text="JORNADA DIARIA • 09:00 AM - 06:00 PM" HBox.hgrow="ALWAYS" />
                                    <Label style="-fx-font-size: 10px; -fx-text-fill: #0F766E; -fx-font-weight: bold;" text="Consultorios 1 y 2 Activos" />
                                 </children>
                              </HBox>
                              <TableView fx:id="tblTurnos" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colHorario" prefWidth="95.0" text="Horario" />
                                    <TableColumn fx:id="colConsultorio" prefWidth="95.0" text="Consultorio" />
                                    <TableColumn fx:id="colPaciente" prefWidth="105.0" text="Paciente" />
                                    <TableColumn fx:id="colTratamiento" prefWidth="120.0" text="Tratamiento" />
                                    <TableColumn fx:id="colDoctor" prefWidth="95.0" text="Doctor" />
                                 </columns>
                              </TableView>
                              <Button fx:id="btnCargar" mnemonicParsing="false" onAction="#onCargarClick" text="📥  Cargar selección en formulario (o doble clic)" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
