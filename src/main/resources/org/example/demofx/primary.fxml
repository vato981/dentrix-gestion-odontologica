<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demofx.PrimaryController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <Label text="Clinica Dental - Pantalla inicial" />
      <Label fx:id="mensaje" text="Pulsa el boton para probar el controller." />
      <Button fx:id="boton" mnemonicParsing="false" onAction="#onBotonClick" text="Probar" />
      <Button fx:id="btnAnchor" mnemonicParsing="false" onAction="#onAnchorClick" text="Ver ejemplo AnchorPane" />
   </children>
</VBox>
