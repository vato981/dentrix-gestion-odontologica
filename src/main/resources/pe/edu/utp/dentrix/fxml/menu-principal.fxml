<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.utp.dentrix.controller.MenuPrincipalController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="barra-superior" BorderPane.alignment="CENTER">
            <children>
                <Label text="🦷" style="-fx-font-size: 16px;" />
                <Label text="Dentrix Dental" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" />
                <Label fx:id="etiquetaPantalla" text="— Consola Principal" style="-fx-text-fill: #99F6E4; -fx-font-size: 13px;" />
                <Label HBox.hgrow="ALWAYS" text=" " />
                <Label text="Centro Odontológico" style="-fx-text-fill: #99F6E4; -fx-font-size: 12px;" />
            </children>
        </HBox>
    </top>
    <left>
        <VBox spacing="4.0" styleClass="sidebar" BorderPane.alignment="CENTER" prefWidth="220.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="sidebar-logo">
                    <children>
                        <StackPane maxHeight="28.0" maxWidth="28.0" minHeight="28.0" minWidth="28.0" styleClass="sidebar-isotipo">
                            <children>
                                <Label text="🦷" styleClass="sidebar-isotipo-icono" />
                            </children>
                        </StackPane>
                        <VBox spacing="1.0">
                            <children>
                                <Label text="Dentrix" styleClass="sidebar-marca" />
                                <Label text="Centro Odontológico" styleClass="sidebar-submarca" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <Button fx:id="btnInicio" maxWidth="Infinity" onAction="#onModuloClick" styleClass="button, nav-boton" text="🏠  Inicio" />
                <Button fx:id="btnSalaEspera" maxWidth="Infinity" onAction="#onModuloClick" styleClass="button, nav-boton" text="🚨  Sala de espera" />
                <Button fx:id="btnPacientes" maxWidth="Infinity" onAction="#onModuloClick" styleClass="button, nav-boton" text="👥  Pacientes" />
                <Button fx:id="btnAgenda" maxWidth="Infinity" onAction="#onModuloClick" styleClass="button, nav-boton" text="📅  Agenda" />
                <Button fx:id="btnFicha" maxWidth="Infinity" onAction="#onModuloClick" styleClass="button, nav-boton" text="📋  Ficha clínica" />
                <Button fx:id="btnPresupuestos" maxWidth="Infinity" onAction="#onModuloClick" styleClass="button, nav-boton" text="📋  Presupuestos" />
                <Button fx:id="btnEjecucion" maxWidth="Infinity" onAction="#onModuloClick" styleClass="button, nav-boton" text="🦷  Ejecución" />
                <Button fx:id="btnCaja" maxWidth="Infinity" onAction="#onModuloClick" styleClass="button, nav-boton" text="💳  Caja / Cobros" />
                <Button fx:id="btnReportes" maxWidth="Infinity" onAction="#onModuloClick" styleClass="button, nav-boton" text="📊  Reportes" />
                <Button fx:id="btnUsuarios" maxWidth="Infinity" onAction="#onModuloClick" styleClass="button, nav-boton" text="🔐  Usuarios" />
                <Button fx:id="btnConfiguracion" maxWidth="Infinity" onAction="#onModuloClick" styleClass="button, nav-boton" text="⚙  Configuración" />
                <Region VBox.vgrow="ALWAYS" />
                <VBox spacing="10.0" styleClass="usuario-bloque">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <StackPane maxHeight="28.0" maxWidth="28.0" minHeight="28.0" minWidth="28.0" styleClass="usuario-avatar">
                                    <children>
                                        <Label fx:id="etiquetaAvatar" styleClass="usuario-avatar-texto" text="" />
                                    </children>
                                </StackPane>
                                <VBox spacing="1.0">
                                    <children>
                                        <Label fx:id="etiquetaUsuario" styleClass="usuario-nombre" text="" />
                                        <Label fx:id="etiquetaRol" styleClass="usuario-rol" text="" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <Button maxWidth="Infinity" onAction="#onSalirClick" styleClass="button, boton-salir" text="🔒  Cerrar sesión" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="panelContenido" BorderPane.alignment="CENTER" style="-fx-padding: 16 20 20 20;" />
    </center>
</BorderPane>
