<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.utp.dentrix.controller.PresupuestoController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 0 0 14 0;">
            <children>
                <Label text="Presupuesto y aceptación" styleClass="label-titulo" />
                <Label HBox.hgrow="ALWAYS" text=" " />
                <Button text="⟳ Recargar" onAction="#onRecargarClick" />
                <ComboBox fx:id="comboPaciente" prefWidth="250.0" promptText="Paciente" />
                <ComboBox fx:id="comboPresupuesto" prefWidth="230.0" promptText="Presupuesto" />
                <Button fx:id="btnNuevoPresupuesto" styleClass="button, boton-primario" text="＋ Nuevo presupuesto" onAction="#onNuevoPresupuestoClick" />
                <Button fx:id="btnDescartar" text="Descartar" onAction="#onDescartarClick" />
                <Button text="Volver" onAction="#onVolverClick" />
            </children>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" focusTraversable="false" pannable="true" style="-fx-background-color: transparent; -fx-background-insets: 0;" BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="14.0">
                    <children>
                        <VBox spacing="8.0" styleClass="tarjeta">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label styleClass="tarjeta-titulo" text="PRESUPUESTO Y ACEPTACIÓN (M10)" />
                                        <Label HBox.hgrow="ALWAYS" text=" " />
                                    </children>
                                </HBox>
                                <Label fx:id="etiquetaCabecera" style="-fx-font-size: 12px;" text="Selecciona un paciente para ver sus presupuestos." wrapText="true" />
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Button fx:id="btnPresentar" text="Presentar" onAction="#onPresentarClick" />
                                        <Button fx:id="btnAceptarTodo" text="Aceptar todo" onAction="#onAceptarTodoClick" />
                                        <Button fx:id="btnAceptarSeleccionados" text="Aceptar seleccionados" onAction="#onAceptarSeleccionadosClick" />
                                        <Button fx:id="btnRechazar" text="Rechazar" onAction="#onRechazarClick" />
                                        <Button fx:id="btnEnmendar" disable="true" onAction="#onEnmendarClick" text="Enmendar plan" />
                                    </children>
                                </HBox>
                                <Label fx:id="etiquetaMensaje" styleClass="etiqueta-estado" text="" wrapText="true" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="tarjeta">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label styleClass="tarjeta-titulo" text="ÍTEMS DEL PRESUPUESTO" />
                                        <Label HBox.hgrow="ALWAYS" text=" " />
                                        <Label styleClass="tarjeta-etiqueta" text="Selecciona con Ctrl para aceptar o firmar varios" />
                                    </children>
                                </HBox>
                                <TableView fx:id="tablaItems" prefHeight="240.0" styleClass="table-view, tabla-datos">
                                    <columns>
                                        <TableColumn fx:id="colPieza" prefWidth="70.0" text="PIEZA" />
                                        <TableColumn fx:id="colPrestacion" prefWidth="240.0" text="PRESTACIÓN" />
                                        <TableColumn fx:id="colFase" prefWidth="120.0" text="FASE" />
                                        <TableColumn fx:id="colPrioridad" prefWidth="60.0" text="PRIOR." />
                                        <TableColumn fx:id="colSesiones" prefWidth="60.0" text="SES." />
                                        <TableColumn fx:id="colPrecio" prefWidth="100.0" text="PRECIO" />
                                        <TableColumn fx:id="colEstado" prefWidth="100.0" text="ESTADO" />
                                        <TableColumn fx:id="colConsentimiento" prefWidth="130.0" text="CONSENTIMIENTO" />
                                    </columns>
                                </TableView>
                                <VBox fx:id="panelFormularioItems" spacing="8.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <ComboBox fx:id="comboTratamiento" prefWidth="280.0" promptText="Tratamiento del tarifario" />
                                                <TextField fx:id="campoPieza" prefWidth="70.0" promptText="Pieza" styleClass="text-field, campo-formulario" />
                                                <ComboBox fx:id="comboFase" prefWidth="150.0" promptText="Fase" />
                                                <Label style="-fx-font-size: 11px;" text="Prioridad:" />
                                                <Spinner fx:id="spinnerPrioridad" prefWidth="70.0" />
                                                <Label style="-fx-font-size: 11px;" text="Cantidad:" />
                                                <Spinner fx:id="spinnerCantidad" prefWidth="70.0" />
                                                <Label style="-fx-font-size: 11px;" text="Sesiones:" />
                                                <Spinner fx:id="spinnerSesiones" prefWidth="70.0" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <CheckBox fx:id="checkConsentimiento" text="Requiere consentimiento" />
                                                <Button styleClass="button, boton-primario" text="Agregar ítem" onAction="#onAgregarItemClick" />
                                                <Button text="Quitar ítem" onAction="#onQuitarItemClick" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="tarjeta">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="TOTALES" />
                                <HBox alignment="CENTER_LEFT" spacing="24.0">
                                    <children>
                                        <Label fx:id="lblSubtotal" style="-fx-font-size: 12px;" text="Subtotal: S/ 0.00" />
                                        <Label fx:id="lblDescuento" style="-fx-font-size: 12px;" text="Descuento: S/ 0.00" />
                                        <Label fx:id="lblTotal" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Total: S/ 0.00" />
                                        <Label fx:id="lblTotalAceptado" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Total aceptado: S/ 0.00" />
                                    </children>
                                </HBox>
                                <Label fx:id="lblDescuentoMotivo" style="-fx-font-size: 11px;" text="" wrapText="true" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="tarjeta">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="DECISIÓN DEL PACIENTE" />
                                <Label style="-fx-font-size: 11px;" text="Aceptar congela los precios del presupuesto (R21): los cambios posteriores del tarifario no alteran este documento." wrapText="true" />
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <TextField fx:id="campoFirmante" prefWidth="220.0" promptText="Firmante" styleClass="text-field, campo-formulario" />
                                        <TextField fx:id="campoDocumento" prefWidth="150.0" promptText="Documento" styleClass="text-field, campo-formulario" />
                                        <ComboBox fx:id="comboRolFirmante" prefWidth="140.0" promptText="Rol del firmante" />
                                    </children>
                                </HBox>
                                <HBox alignment="TOP_LEFT" spacing="8.0">
                                    <children>
                                        <TextArea fx:id="areaAlternativas" prefHeight="62.0" prefWidth="420.0" promptText="Alternativas ofrecidas" styleClass="campo-formulario" wrapText="true" />
                                        <TextArea fx:id="areaRiesgos" prefHeight="62.0" prefWidth="420.0" promptText="Riesgos informados" styleClass="campo-formulario" wrapText="true" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Button fx:id="btnRegistrarAceptacion" styleClass="button, boton-primario" text="Registrar aceptación" onAction="#onRegistrarAceptacionClick" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <VBox fx:id="tarjetaConsentimiento" spacing="8.0" styleClass="tarjeta">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="CONSENTIMIENTO INFORMADO" />
                                <Label style="-fx-font-size: 11px;" text="R7: el procedimiento exige presupuesto ACEPTADO y consentimiento firmado por el paciente, tutor o pagador." wrapText="true" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Button fx:id="btnFirmarConsentimiento" styleClass="button, boton-primario" text="Firmar consentimiento de seleccionados" onAction="#onFirmarConsentimientoClick" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
