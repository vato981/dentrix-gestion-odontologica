<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.utp.dentrix.controller.UsuariosController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 0 0 14 0;">
            <children>
                <Label text="Usuarios y accesos" styleClass="label-titulo" />
                <Label HBox.hgrow="ALWAYS" text=" " />
                <Button text="Volver" onAction="#onVolverClick" />
                <Button text="⟳ Refrescar" onAction="#onRefrescarClick" />
            </children>
        </HBox>
    </top>
    <center>
        <HBox spacing="16.0" BorderPane.alignment="CENTER">
            <children>
                <VBox spacing="10.0" prefWidth="420.0" styleClass="tarjeta" HBox.hgrow="NEVER">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="FICHA DEL USUARIO" />
                                <Label HBox.hgrow="ALWAYS" text=" " />
                                <Label fx:id="etiquetaModo" styleClass="tarjeta-etiqueta" text="NUEVO" />
                            </children>
                        </HBox>
                        <Label style="-fx-font-size: 11px;" text="Username:" />
                        <TextField fx:id="campoUsername" promptText="jvallejos" styleClass="campo-formulario" />
                        <Label style="-fx-font-size: 11px;" text="Nombres:" />
                        <TextField fx:id="campoNombres" styleClass="campo-formulario" />
                        <Label style="-fx-font-size: 11px;" text="Apellidos:" />
                        <TextField fx:id="campoApellidos" styleClass="campo-formulario" />
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 11px;" text="DNI:" />
                                        <TextField fx:id="campoDni" prefWidth="120.0" promptText="8 dígitos" styleClass="campo-formulario" />
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 11px;" text="Rol (M9.1 · matriz RBAC):" />
                                        <ComboBox fx:id="comboRol" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 11px;" text="Colegiatura (odólogos):" />
                                        <TextField fx:id="campoColegiatura" styleClass="campo-formulario" />
                                    </children>
                                </VBox>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 11px;" text="Especialidad:" />
                                        <TextField fx:id="campoEspecialidad" styleClass="campo-formulario" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <Label style="-fx-font-size: 11px;" text="Clave (obligatoria al crear; vacía = no cambiar):" />
                        <PasswordField fx:id="campoClave" promptText="Mínimo 8 caracteres" styleClass="campo-formulario" />
                        <Label fx:id="etiquetaError" styleClass="etiqueta-error" text="" wrapText="true" />
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button text="Cancelar" onAction="#onNuevoClick" />
                                <Button defaultButton="true" styleClass="boton-primario" text="💾 Guardar" onAction="#onGuardarClick" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <VBox spacing="10.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="PADRÓN DE USUARIOS Y ACCESOS" />
                                <Label HBox.hgrow="ALWAYS" text=" " />
                                <Label fx:id="etiquetaConteo" styleClass="tarjeta-etiqueta" text="" />
                            </children>
                        </HBox>
                        <TableView fx:id="tablaUsuarios" styleClass="tabla-datos" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colUsername" prefWidth="130.0" text="USERNAME" />
                                <TableColumn fx:id="colNombre" prefWidth="230.0" text="NOMBRE" />
                                <TableColumn fx:id="colDni" prefWidth="100.0" text="DNI" />
                                <TableColumn fx:id="colRol" prefWidth="140.0" text="ROL" />
                                <TableColumn fx:id="colColegiatura" prefWidth="120.0" text="COLEGIATURA" />
                                <TableColumn fx:id="colEstado" prefWidth="110.0" text="ESTADO" />
                                <TableColumn fx:id="colAcciones" prefWidth="170.0" text="ACCIONES" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>
