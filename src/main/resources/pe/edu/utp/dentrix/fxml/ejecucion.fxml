<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.utp.dentrix.controller.EjecucionController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 0 0 14 0;">
            <children>
                <Label text="Ejecución de sesiones" styleClass="label-titulo" />
                <Label HBox.hgrow="ALWAYS" text=" " />
                <Button text="⟳ Recargar" onAction="#onRecargarClick" />
                <ComboBox fx:id="comboPaciente" prefWidth="250.0" promptText="Paciente" />
                <ComboBox fx:id="comboPresupuesto" prefWidth="230.0" promptText="Plan aceptado" />
                <Button fx:id="btnCerrarPlan" text="Cerrar plan" onAction="#onCerrarPlanClick" />
                <Button text="Volver" onAction="#onVolverClick" />
            </children>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" focusTraversable="false" pannable="true" style="-fx-background-color: transparent; -fx-background-insets: 0;" BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="14.0">
                    <children>
                        <VBox spacing="8.0" styleClass="tarjeta">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label styleClass="tarjeta-titulo" text="ÍTEMS DEL PLAN ACEPTADO" />
                                        <Label HBox.hgrow="ALWAYS" text=" " />
                                        <Label fx:id="etiquetaMensaje" styleClass="etiqueta-estado" text="" wrapText="true" />
                                    </children>
                                </HBox>
                                <TableView fx:id="tablaItems" prefHeight="220.0" styleClass="table-view, tabla-datos">
                                    <columns>
                                        <TableColumn fx:id="colPieza" prefWidth="70.0" text="PIEZA" />
                                        <TableColumn fx:id="colPrestacion" prefWidth="260.0" text="PRESTACIÓN" />
                                        <TableColumn fx:id="colFase" prefWidth="130.0" text="FASE" />
                                        <TableColumn fx:id="colSesiones" prefWidth="100.0" text="SESIONES" />
                                        <TableColumn fx:id="colEstado" prefWidth="130.0" text="ESTADO" />
                                        <TableColumn fx:id="colControl" prefWidth="120.0" text="CONTROL" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="tarjeta">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label styleClass="tarjeta-titulo" text="SESIÓN" />
                                        <Label HBox.hgrow="ALWAYS" text=" " />
                                        <Label fx:id="etiquetaItem" styleClass="tarjeta-etiqueta" text="Selecciona un ítem" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Button fx:id="btnAbrirSesion" styleClass="button, boton-primario" text="Abrir sesión" onAction="#onAbrirSesionClick" />
                                        <Button fx:id="btnFirmarSesion" text="Firmar sesión" onAction="#onFirmarSesionClick" />
                                        <Button fx:id="btnDescartarSesion" text="Descartar sesión" onAction="#onDescartarSesionClick" />
                                        <Button fx:id="btnAnularSesion" text="Anular sesión" onAction="#onAnularSesionClick" />
                                        <Button fx:id="btnLaboratorio" text="Laboratorio / insumos" onAction="#onLaboratorioClick" />
                                    </children>
                                </HBox>
                                <TableView fx:id="tablaSesiones" prefHeight="150.0" styleClass="table-view, tabla-datos">
                                    <columns>
                                        <TableColumn fx:id="colSesNumero" prefWidth="70.0" text="N°" />
                                        <TableColumn fx:id="colSesFecha" prefWidth="150.0" text="FECHA" />
                                        <TableColumn fx:id="colSesProfesional" prefWidth="220.0" text="PROFESIONAL" />
                                        <TableColumn fx:id="colSesEstado" prefWidth="120.0" text="ESTADO" />
                                    </columns>
                                </TableView>
                                <Label style="-fx-font-size: 11px;" text="Evolución" />
                                <TextArea fx:id="areaEvolucion" editable="false" prefHeight="90.0" promptText="Sin evolución firmada para la sesión seleccionada" styleClass="campo-formulario" wrapText="true" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="tarjeta">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label styleClass="tarjeta-titulo" text="CONTROL POST" />
                                        <Label HBox.hgrow="ALWAYS" text=" " />
                                    </children>
                                </HBox>
                                <Label fx:id="lblControlFecha" style="-fx-font-size: 12px;" text="Sin control programado" wrapText="true" />
                                <Label fx:id="lblControlHallazgo" style="-fx-font-size: 11px;" text="" wrapText="true" />
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Button fx:id="btnProgramarControl" text="Programar control" onAction="#onProgramarControlClick" />
                                        <Button fx:id="btnRegistrarControl" text="Registrar control" onAction="#onRegistrarControlClick" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="tarjeta">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label styleClass="tarjeta-titulo" text="PLAN" />
                                        <Label HBox.hgrow="ALWAYS" text=" " />
                                    </children>
                                </HBox>
                                <Label fx:id="lblPlanCierre" style="-fx-font-size: 12px;" text="Plan sin cierre registrado" wrapText="true" />
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Button fx:id="btnCerrarPlanTarjeta" text="Cerrar plan" onAction="#onCerrarPlanClick" />
                                    </children>
                                </HBox>
                                <Label fx:id="etiquetaError" styleClass="etiqueta-error" text="" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
