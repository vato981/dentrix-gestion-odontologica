<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.utp.dentrix.controller.DashboardController" spacing="16.0">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="tarjeta">
            <children>
                <Label styleClass="tarjeta-titulo" text="BÚSQUEDA RÁPIDA" />
                <TextField fx:id="campoDni" prefWidth="220.0" promptText="DNI del paciente (8 dígitos)..." styleClass="campo-formulario" />
                <Button defaultButton="true" text="🔍 Buscar" onAction="#onBuscarClick" styleClass="boton-primario" />
                <Button text="+ Registrar Nuevo Paciente" onAction="#onRegistrarPacienteClick" />
                <Label fx:id="etiquetaBusqueda" HBox.hgrow="ALWAYS" text="" wrapText="true" />
            </children>
        </HBox>
        <GridPane hgap="14.0" vgap="14.0">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
            </columnConstraints>
            <children>
                <VBox styleClass="tarjeta" GridPane.columnIndex="0">
                    <children>
                        <Label styleClass="kpi-titulo" text="CITAS HOY" />
                        <Label fx:id="kpiCitas" styleClass="kpi-valor" text="—" />
                    </children>
                </VBox>
                <VBox styleClass="tarjeta" GridPane.columnIndex="1">
                    <children>
                        <Label styleClass="kpi-titulo" text="EN SALA DE ESPERA" />
                        <Label fx:id="kpiSala" styleClass="kpi-valor" text="—" />
                    </children>
                </VBox>
                <VBox styleClass="tarjeta" GridPane.columnIndex="2">
                    <children>
                        <Label styleClass="kpi-titulo" text="RECAUDACIÓN HOY" />
                        <Label fx:id="kpiRecaudado" styleClass="kpi-valor" text="—" />
                    </children>
                </VBox>
                <VBox styleClass="tarjeta" GridPane.columnIndex="3">
                    <children>
                        <Label styleClass="kpi-titulo" text="SALDOS POR COBRAR" />
                        <Label fx:id="kpiDeudores" styleClass="kpi-valor" text="—" />
                    </children>
                </VBox>
            </children>
        </GridPane>
        <VBox styleClass="tarjeta" VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label styleClass="tarjeta-titulo" text="AGENDA ODONTOLÓGICA DEL DÍA" />
                        <Label fx:id="etiquetaFechaAgenda" styleClass="tarjeta-etiqueta" text="" />
                        <Label HBox.hgrow="ALWAYS" text=" " />
                        <Label styleClass="tarjeta-etiqueta" text="Consultorios 1 y 2" />
                    </children>
                </HBox>
                <TableView fx:id="tablaAgenda" prefHeight="360.0" styleClass="tabla-datos">
                    <columns>
                        <TableColumn fx:id="colHora" prefWidth="120.0" text="HORA" />
                        <TableColumn fx:id="colPaciente" prefWidth="220.0" text="PACIENTE" />
                        <TableColumn fx:id="colTratamiento" prefWidth="240.0" text="TRATAMIENTO" />
                        <TableColumn fx:id="colOdontologo" prefWidth="180.0" text="ODONTÓLOGO" />
                        <TableColumn fx:id="colEstado" prefWidth="130.0" text="ESTADO" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
