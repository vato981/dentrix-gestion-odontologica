<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.utp.dentrix.controller.CajaController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 0 0 14 0;">
            <children>
                <Label text="Caja" styleClass="label-titulo" />
                <Label fx:id="etiquetaCajero" styleClass="etiqueta-estado" text="" />
                <Label HBox.hgrow="ALWAYS" text=" " />
                <Button text="Volver" onAction="#onVolverClick" />
                <Button styleClass="button, boton-primario" text="🧾 Caja" onAction="#onCajaClick" />
                <Button text="🏦 Cierre del día" onAction="#onCierreClick" />
            </children>
        </HBox>
    </top>
    <center>
        <StackPane BorderPane.alignment="CENTER">
            <children>
                <HBox fx:id="panelCaja" spacing="16.0">
                    <children>
                        <VBox spacing="10.0" prefWidth="480.0" styleClass="tarjeta" HBox.hgrow="NEVER">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="LIQUIDACIÓN / COBRO" />
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label style="-fx-font-size: 11px;" text="Paciente:" />
                                        <ComboBox fx:id="comboPaciente" prefWidth="330.0" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <ComboBox fx:id="comboTratamiento" prefWidth="280.0" />
                                        <TextField fx:id="campoPieza" prefWidth="90.0" promptText="Pieza FDI" styleClass="text-field, campo-formulario" />
                                        <TextField fx:id="campoCantidad" prefWidth="50.0" styleClass="text-field, campo-formulario" text="1" />
                                        <Button text="Agregar" onAction="#onAgregarLineaClick" />
                                        <Button text="Quitar" onAction="#onQuitarLineaClick" />
                                    </children>
                                </HBox>
                                <TableView fx:id="tablaLineas" prefHeight="240.0" styleClass="table-view, tabla-datos">
                                    <columns>
                                        <TableColumn fx:id="colTratamiento" prefWidth="210.0" text="TRATAMIENTO" />
                                        <TableColumn fx:id="colPieza" prefWidth="70.0" text="PIEZA" />
                                        <TableColumn fx:id="colCantidad" prefWidth="60.0" text="CANT." />
                                        <TableColumn fx:id="colPrecio" prefWidth="90.0" text="P. UNIT." />
                                        <TableColumn fx:id="colSubtotal" prefWidth="100.0" text="SUBTOTAL" />
                                    </columns>
                                </TableView>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label style="-fx-font-size: 11px;" text="Modalidad:" />
                                        <ComboBox fx:id="comboModalidad" prefWidth="120.0" />
                                        <TextField fx:id="campoOperacion" prefWidth="200.0" promptText="N° operación" styleClass="text-field, campo-formulario" />
                                    </children>
                                </HBox>
                                <Label fx:id="etiquetaResultado" styleClass="etiqueta-error" text="" wrapText="true" />
                                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                    <children>
                                        <Label style="-fx-font-size: 11px;" text="TOTAL:" />
                                        <Label fx:id="lblTotal" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: Consolas;" text="S/ 0.00" />
                                        <Button defaultButton="true" styleClass="button, boton-primario" text="Emitir boleta" onAction="#onEmitirClick" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox spacing="8.0" styleClass="tarjeta" VBox.vgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label styleClass="tarjeta-titulo" text="HISTORIAL DE BOLETAS DEL DÍA" />
                                                <Label HBox.hgrow="ALWAYS" text=" " />
                                                <Label fx:id="etiquetaFechaHoy" styleClass="tarjeta-etiqueta" text="" />
                                                <Button text="⟳" onAction="#onRefrescarBoletasClick" />
                                            </children>
                                        </HBox>
                                        <TableView fx:id="tablaBoletas" styleClass="table-view, tabla-datos" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colBNumero" prefWidth="130.0" text="NÚMERO" />
                                                <TableColumn fx:id="colBFecha" prefWidth="140.0" text="FECHA" />
                                                <TableColumn fx:id="colBMonto" prefWidth="90.0" text="MONTO" />
                                                <TableColumn fx:id="colBModalidad" prefWidth="100.0" text="MODALIDAD" />
                                                <TableColumn fx:id="colBEstado" prefWidth="110.0" text="ESTADO PAGO" />
                                                <TableColumn fx:id="colBSaldo" prefWidth="90.0" text="SALDO" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>
                                <VBox spacing="8.0" styleClass="tarjeta">
                                    <children>
                                        <Label styleClass="tarjeta-titulo" text="ABONOS A BOLETA" />
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label style="-fx-font-size: 11px;" text="N° boleta:" />
                                                <TextField fx:id="campoNumeroBoleta" prefWidth="150.0" promptText="B001-000458" styleClass="text-field, campo-formulario" />
                                                <Button text="Cargar boleta" onAction="#onCargarBoletaClick" />
                                            </children>
                                        </HBox>
                                        <Label fx:id="etiquetaDocumento" styleClass="etiqueta-estado" text="Ingresa el número de una boleta con saldo para abonar." wrapText="true" />
                                        <TableView fx:id="tablaAbonos" prefHeight="110.0" styleClass="table-view, tabla-datos">
                                            <columns>
                                                <TableColumn fx:id="colAFecha" prefWidth="160.0" text="FECHA" />
                                                <TableColumn fx:id="colAMonto" prefWidth="100.0" text="MONTO" />
                                                <TableColumn fx:id="colAModalidad" prefWidth="110.0" text="MODALIDAD" />
                                                <TableColumn fx:id="colAOp" prefWidth="140.0" text="N° OPERACIÓN" />
                                            </columns>
                                        </TableView>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label style="-fx-font-size: 11px;" text="Abonar S/" />
                                                <TextField fx:id="campoMontoAbono" prefWidth="90.0" promptText="0.00" styleClass="text-field, campo-formulario" />
                                                <ComboBox fx:id="comboModalidadAbono" prefWidth="120.0" />
                                                <TextField fx:id="campoOpAbono" prefWidth="180.0" promptText="N° operación si no es efectivo" styleClass="text-field, campo-formulario" />
                                                <Button defaultButton="true" styleClass="button, boton-primario" text="Registrar abono" onAction="#onRegistrarAbonoClick" />
                                            </children>
                                        </HBox>
                                        <Label fx:id="etiquetaAbonoResultado" styleClass="etiqueta-error" text="" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <VBox fx:id="panelCierre" spacing="10.0" styleClass="tarjeta" visible="false">
                    <children>
                        <Label styleClass="tarjeta-titulo" text="CIERRE DEL DÍA (M7.1)" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label style="-fx-font-size: 11px;" text="Turno:" />
                                <ComboBox fx:id="comboTurno" prefWidth="120.0" />
                                <Label style="-fx-font-size: 11px;" text="Fondo inicial S/" />
                                <TextField fx:id="campoFondo" prefWidth="90.0" promptText="100.00" styleClass="text-field, campo-formulario" />
                                <Button styleClass="button, boton-primario" text="Abrir cierre" onAction="#onAbrirCierreClick" />
                            </children>
                        </HBox>
                        <Label fx:id="etiquetaSinCierre" styleClass="etiqueta-estado" text="" wrapText="true" />
                        <Label fx:id="etiquetaCierreInfo" style="-fx-font-family: Consolas; -fx-font-size: 12px;" text="" wrapText="true" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label style="-fx-font-size: 11px;" text="Nuevo fondo S/" />
                                <TextField fx:id="campoNuevoFondo" prefWidth="90.0" styleClass="text-field, campo-formulario" />
                                <Button text="Cambiar fondo (RF-09)" onAction="#onCambiarFondoClick" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label style="-fx-font-size: 11px;" text="Efectivo contado S/" />
                                <TextField fx:id="campoContado" prefWidth="90.0" styleClass="text-field, campo-formulario" />
                                <Button styleClass="button, boton-primario" text="Consolidar cierre" onAction="#onConsolidarClick" />
                                <Button text="Marcar acta generada" onAction="#onActaClick" />
                            </children>
                        </HBox>
                        <Label fx:id="etiquetaCierreResultado" styleClass="etiqueta-error" text="" />
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>
