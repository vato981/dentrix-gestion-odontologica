<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.utp.dentrix.controller.AgendaController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 0 0 14 0;">
            <children>
                <Label text="📅 Fecha:" />
                <DatePicker fx:id="campoFecha" prefWidth="150.0" />
                <Label fx:id="etiquetaConteo" styleClass="etiqueta-estado" text="" />
                <Label HBox.hgrow="ALWAYS" text=" " />
                <Button text="Volver" onAction="#onVolverClick" />
                <Button text="⟳ Refrescar" onAction="#onRefrescarClick" />
                <Button styleClass="button, boton-primario" text="🗓 Nueva Cita" onAction="#onNuevaCitaClick" />
                <Button text="⬛ Bloquear Hora" onAction="#onBloquearClick" />
            </children>
        </HBox>
    </top>
    <center>
        <HBox spacing="16.0" BorderPane.alignment="CENTER">
            <children>
                <VBox spacing="10.0" styleClass="tarjeta" prefWidth="380.0" HBox.hgrow="NEVER">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="FORMULARIO DE CITA" />
                                <Label HBox.hgrow="ALWAYS" text=" " />
                                <Label fx:id="etiquetaModo" styleClass="tarjeta-etiqueta" text="NUEVA" />
                            </children>
                        </HBox>
                        <GridPane hgap="8.0" vgap="8.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="36.0" />
                                <ColumnConstraints percentWidth="64.0" hgrow="ALWAYS" />
                            </columnConstraints>
                            <children>
                                <Label fx:id="etiquetaTipo" style="-fx-font-size: 11px;" text="Tipo:" GridPane.rowIndex="0" />
                                <ComboBox fx:id="comboTipo" styleClass="combo-box, combo-formulario" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                <Label style="-fx-font-size: 11px;" text="Hora inicio:" GridPane.rowIndex="1" />
                                <TextField fx:id="campoInicio" promptText="09:00" styleClass="text-field, campo-formulario" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label style="-fx-font-size: 11px;" text="Hora fin:" GridPane.rowIndex="2" />
                                <TextField fx:id="campoFin" promptText="09:45" styleClass="text-field, campo-formulario" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <Label fx:id="etiquetaPaciente" style="-fx-font-size: 11px;" text="Paciente:" GridPane.rowIndex="3" />
                                <ComboBox fx:id="comboPaciente" styleClass="combo-box, combo-formulario" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                <Label style="-fx-font-size: 11px;" text="Odontólogo:" GridPane.rowIndex="4" />
                                <ComboBox fx:id="comboOdontologo" styleClass="combo-box, combo-formulario" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                <Label style="-fx-font-size: 11px;" text="Consultorio:" GridPane.rowIndex="5" />
                                <ComboBox fx:id="comboConsultorio" styleClass="combo-box, combo-formulario" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                <Label fx:id="etiquetaTratamiento" style="-fx-font-size: 11px;" text="Tratamiento (opcional):" GridPane.rowIndex="6" />
                                <ComboBox fx:id="comboTratamiento" styleClass="combo-box, combo-formulario" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                                <Label fx:id="etiquetaMotivo" style="-fx-font-size: 11px;" text="Motivo:" GridPane.rowIndex="7" />
                                <TextField fx:id="campoMotivo" promptText="Motivo de la cita o del bloque" styleClass="text-field, campo-formulario" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                            </children>
                        </GridPane>
                        <Label fx:id="etiquetaError" styleClass="etiqueta-error" text="" wrapText="true" />
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button text="Cancelar" onAction="#onCancelarClick" />
                                <Button defaultButton="true" styleClass="button, boton-primario" text="💾 Guardar" onAction="#onGuardarClick" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <VBox spacing="10.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="JORNADA DEL DÍA" />
                                <Label HBox.hgrow="ALWAYS" text=" " />
                                <Label styleClass="tarjeta-etiqueta" text="Consultorios 1 y 2" />
                            </children>
                        </HBox>
                        <TableView fx:id="tablaAgenda" styleClass="table-view, tabla-datos" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colHora" prefWidth="110.0" text="HORA" />
                                <TableColumn fx:id="colConsultorio" prefWidth="110.0" text="CONSULT." />
                                <TableColumn fx:id="colPaciente" prefWidth="180.0" text="PACIENTE" />
                                <TableColumn fx:id="colTratamiento" prefWidth="200.0" text="TRATAMIENTO / MOTIVO" />
                                <TableColumn fx:id="colOdontologo" prefWidth="140.0" text="DOCTOR" />
                                <TableColumn fx:id="colEstado" prefWidth="120.0" text="ESTADO" />
                                <TableColumn fx:id="colAccion" prefWidth="170.0" text="ACCIÓN" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>
