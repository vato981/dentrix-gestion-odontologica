<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14.0" style="-fx-padding: 40;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.utp.dentrix.controller.LoginController">
    <children>
        <Label text="Dentrix" style="-fx-font-size: 36px; -fx-font-weight: bold;" />
        <Label text="Sistema de Gestión Clínica" style="-fx-font-size: 14px; -fx-text-fill: #666666;" />
        <TextField fx:id="campoUsuario" promptText="Usuario" prefWidth="280.0" />
        <PasswordField fx:id="campoClave" promptText="Contraseña" prefWidth="280.0" />
        <Label fx:id="etiquetaError" text="" style="-fx-text-fill: #C62828;" />
        <Button text="Ingresar" defaultButton="true" prefWidth="280.0" styleClass="boton-primario" onAction="#onIngresarClick" />
    </children>
</VBox>
