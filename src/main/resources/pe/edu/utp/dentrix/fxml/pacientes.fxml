<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.utp.dentrix.controller.PacientesController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 0 0 14 0;">
            <children>
                <TextField fx:id="campoBusqueda" prefWidth="300.0" promptText="Buscar por DNI, Apellidos o Código..." styleClass="campo-formulario" />
                <Button text="🔍 Buscar" onAction="#onBuscarClick" />
                <Label HBox.hgrow="ALWAYS" text=" " />
                <Button text="Volver" onAction="#onVolverClick" />
                <Button text="⟳ Refrescar" onAction="#onRefrescarClick" />
                <Button styleClass="boton-primario" text="➕ Nuevo Paciente" onAction="#onNuevoClick" />
            </children>
        </HBox>
    </top>
    <center>
        <HBox spacing="16.0" BorderPane.alignment="CENTER">
            <children>
                <VBox spacing="10.0" styleClass="tarjeta" prefWidth="360.0" HBox.hgrow="NEVER">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="FICHA DEMOGRÁFICA DEL PACIENTE" />
                                <Label HBox.hgrow="ALWAYS" text=" " />
                                <Label fx:id="etiquetaModo" styleClass="tarjeta-etiqueta" text="NUEVO" />
                            </children>
                        </HBox>
                        <Label fx:id="etiquetaCodigo" styleClass="etiqueta-estado" text="El código HC se genera automáticamente" wrapText="true" />
                        <GridPane hgap="8.0" vgap="8.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="34.0" />
                                <ColumnConstraints percentWidth="66.0" hgrow="ALWAYS" />
                            </columnConstraints>
                            <children>
                                <Label style="-fx-font-size: 11px;" text="DNI *" GridPane.rowIndex="0" />
                                <TextField fx:id="campoDni" promptText="8 dígitos" styleClass="campo-formulario" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                <Label style="-fx-font-size: 11px;" text="Código HC" GridPane.rowIndex="1" />
                                <TextField fx:id="campoCodigo" disable="true" promptText="Autogenerado" styleClass="campo-formulario" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label style="-fx-font-size: 11px;" text="Apellidos *" GridPane.rowIndex="2" />
                                <TextField fx:id="campoApellidos" styleClass="campo-formulario" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <Label style="-fx-font-size: 11px;" text="Nombres *" GridPane.rowIndex="3" />
                                <TextField fx:id="campoNombres" styleClass="campo-formulario" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                <Label style="-fx-font-size: 11px;" text="F. Nacimiento" GridPane.rowIndex="4" />
                                <DatePicker fx:id="campoFechaNac" styleClass="campo-formulario" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                <Label style="-fx-font-size: 11px;" text="Celular" GridPane.rowIndex="5" />
                                <TextField fx:id="campoCelular" styleClass="campo-formulario" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                <Label style="-fx-font-size: 11px;" text="Email" GridPane.rowIndex="6" />
                                <TextField fx:id="campoEmail" styleClass="campo-formulario" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                                <Label style="-fx-font-size: 11px;" text="Dirección" GridPane.rowIndex="7" />
                                <TextField fx:id="campoDireccion" styleClass="campo-formulario" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                                <Label style="-fx-font-size: 11px;" text="Alergias" GridPane.rowIndex="8" />
                                <TextArea fx:id="campoAlergias" prefRowCount="2" styleClass="campo-formulario" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                                <Label style="-fx-font-size: 11px;" text="Antecedentes" GridPane.rowIndex="9" />
                                <TextArea fx:id="campoAntecedentes" prefRowCount="2" styleClass="campo-formulario" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="9" />
                            </children>
                        </GridPane>
                        <Label fx:id="etiquetaError" styleClass="etiqueta-error" text="" wrapText="true" />
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button text="Cancelar" onAction="#onCancelarClick" />
                                <Button defaultButton="true" styleClass="boton-primario" text="💾 Guardar Datos del Paciente" onAction="#onGuardarClick" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <VBox spacing="10.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="PADRÓN GENERAL REGISTRADO" />
                                <Label HBox.hgrow="ALWAYS" text=" " />
                                <Label fx:id="etiquetaConteo" styleClass="tarjeta-etiqueta" text="" />
                            </children>
                        </HBox>
                        <TableView fx:id="tablaPacientes" styleClass="tabla-datos" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCodigo" prefWidth="100.0" text="CÓDIGO" />
                                <TableColumn fx:id="colDni" prefWidth="100.0" text="DNI" />
                                <TableColumn fx:id="colNombre" prefWidth="230.0" text="APELLIDOS Y NOMBRES" />
                                <TableColumn fx:id="colCelular" prefWidth="120.0" text="CELULAR" />
                                <TableColumn fx:id="colAcciones" prefWidth="150.0" text="ACCIONES" />
                            </columns>
                        </TableView>
                        <Label fx:id="etiquetaEstado" styleClass="etiqueta-estado" text="" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>
