<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.utp.dentrix.controller.SalaEsperaController">
    <top>
        <VBox spacing="10.0" style="-fx-padding: 0 0 14 0;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label text="Recepcion / Asistencia" styleClass="label-titulo" />
                        <Label fx:id="etiquetaFecha" styleClass="tarjeta-etiqueta" text="" />
                        <Label HBox.hgrow="ALWAYS" text=" " />
                        <Button text="Volver" onAction="#onVolverClick" />
                        <Button text="Refrescar" onAction="#onRefrescarClick" />
                        <Button styleClass="button, boton-primario" text="Ver en Agenda" onAction="#onVerAgendaClick" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label fx:id="etiquetaPendientes" styleClass="badge, badge-gris" text="Pendientes: 0" />
                        <Label fx:id="etiquetaEnSala" styleClass="badge, badge-amarillo" text="En sala: 0" />
                        <Label fx:id="etiquetaAtendidos" styleClass="badge, badge-verde" text="Atendidos: 0" />
                        <Label fx:id="etiquetaFaltantes" styleClass="badge, badge-rojo" text="Faltantes: 0" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <HBox spacing="16.0" BorderPane.alignment="CENTER">
            <children>
                <VBox spacing="10.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="PACIENTES DEL DIA" />
                                <Label HBox.hgrow="ALWAYS" text=" " />
                                <Label styleClass="tarjeta-etiqueta" text="Doble clic para abrir la ficha" />
                            </children>
                        </HBox>
                        <TableView fx:id="tablaCola" styleClass="table-view, tabla-datos" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colHora" prefWidth="90.0" text="HORA" />
                                <TableColumn fx:id="colPaciente" prefWidth="260.0" text="PACIENTE" />
                                <TableColumn fx:id="colEstado" prefWidth="130.0" text="ESTADO" />
                                <TableColumn fx:id="colAccion" prefWidth="210.0" text="ACCION" />
                            </columns>
                            <placeholder>
                                <Label styleClass="etiqueta-estado" text="Sin citas para hoy." />
                            </placeholder>
                        </TableView>
                    </children>
                </VBox>
                <VBox spacing="12.0" styleClass="tarjeta" prefWidth="390.0" minWidth="350.0" maxHeight="Infinity">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="tarjeta-titulo" text="FICHA DEL PACIENTE" />
                                <Label HBox.hgrow="ALWAYS" text=" " />
                                <Label fx:id="etiquetaEstadoBadge" styleClass="badge-estado, badge-estado-gris" text="—" />
                            </children>
                        </HBox>

                        <VBox styleClass="card-paciente" spacing="10.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <Label fx:id="etiquetaAvatar" styleClass="avatar" text="--" />
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label fx:id="etiquetaSelPaciente" styleClass="nombre-paciente" text="— selecciona una fila —" wrapText="true" />
                                                <Label fx:id="etiquetaDni" styleClass="dato-secundario" text="" />
                                                <Label fx:id="etiquetaEdadSexo" styleClass="dato-secundario" text="" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="seccion-titulo" text="DATOS DE LA CITA" />
                                <Region HBox.hgrow="ALWAYS" styleClass="linea-seccion" />
                            </children>
                        </HBox>

                        <VBox spacing="0.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="fila-dato">
                                    <children>
                                        <Label minWidth="104.0" styleClass="fila-dato-label" text="Tratamiento" />
                                        <Label fx:id="etiquetaTratamiento" HBox.hgrow="ALWAYS" styleClass="fila-dato-valor" wrapText="true" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="fila-dato">
                                    <children>
                                        <Label minWidth="104.0" styleClass="fila-dato-label" text="Odontologo" />
                                        <Label fx:id="etiquetaOdontologo" HBox.hgrow="ALWAYS" styleClass="fila-dato-valor" wrapText="true" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="fila-dato">
                                    <children>
                                        <Label minWidth="104.0" styleClass="fila-dato-label" text="Consultorio" />
                                        <Label fx:id="etiquetaConsultorio" HBox.hgrow="ALWAYS" styleClass="fila-dato-valor" wrapText="true" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="fila-dato">
                                    <children>
                                        <Label minWidth="104.0" styleClass="fila-dato-label" text="Horario" />
                                        <Label fx:id="etiquetaHorario" HBox.hgrow="ALWAYS" styleClass="fila-dato-valor" wrapText="true" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="seccion-titulo" text="OBSERVACIONES" />
                                <Region HBox.hgrow="ALWAYS" styleClass="linea-seccion" />
                            </children>
                        </HBox>
                        <VBox styleClass="panel-observacion">
                            <children>
                                <Label fx:id="etiquetaObservaciones" styleClass="dato-secundario" text="—" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 0 0 0;">
            <children>
                <Label fx:id="etiquetaOperacion" styleClass="etiqueta-estado" text="" wrapText="true" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
